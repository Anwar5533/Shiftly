// ─── Prisma Schema — SHIFTLY Applications Service ───────────────

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-applications-service"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["applications", "jobs", "employers", "workers", "identity", "recruiters"]
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  COMPLETED
  @@schema("jobs")
}

enum JobType {
  SHIFT
  PERMANENT
  GIG
  @@schema("jobs")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  FILLED
  CANCELLED
  ARCHIVED
  EXPIRED
  @@schema("jobs")
}

enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
  FIXED
  @@schema("jobs")
}

// ─── JOBS SCHEMA ─────────────────────────────────────────────────────────────

model Job {
  id                     String       @id @default(uuid()) @db.Uuid
  employerId             String       @db.Uuid
  recruiterId            String?      @db.Uuid
  departmentId           String?      @db.Uuid
  title                  String
  description            String
  aiOptimisedDescription String?
  jobType                JobType
  status                 JobStatus    @default(DRAFT)
  location               Json // JobLocation object
  isRemote               Boolean      @default(false)
  salaryMin              Decimal      @db.Decimal(12, 2)
  salaryMax              Decimal      @db.Decimal(12, 2)
  salaryCurrency         String       @default("INR") @db.VarChar(3)
  salaryPeriod           SalaryPeriod @default(HOURLY)
  startDate              DateTime
  endDate                DateTime?
  shiftDurationHours     Decimal?     @db.Decimal(4, 2)
  positionsTotal         Int          @default(1)
  positionsFilled        Int          @default(0)
  applicationDeadline    DateTime?
  viewCount              Int          @default(0)
  applicationCount       Int          @default(0)
  publishedAt            DateTime?
  expiresAt              DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  applications JobApplication[]

  @@map("jobs")
  @@schema("jobs")
}

// ─── APPLICATIONS SCHEMA ─────────────────────────────────────────────────────

model JobApplication {
  id           String            @id @default(uuid()) @db.Uuid
  jobId        String            @db.Uuid
  workerId     String            @db.Uuid
  employerId   String            @db.Uuid
  status       ApplicationStatus @default(PENDING)
  coverLetter  String?
  aiScore      Decimal?          @db.Decimal(5, 2)
  aiBreakdown  Json? // MatchBreakdown object
  employerNote String?
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  job    Job           @relation(fields: [jobId], references: [id])
  worker WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
  @@index([employerId])
  @@index([status])
  @@index([jobId, status])
  @@index([workerId, status, appliedAt(sort: Desc)])
  @@map("job_applications")
  @@schema("jobs")
}

// ─── WORKERS SCHEMA ───────────────────────────────────────────────────────────

model WorkerProfile {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  firstName       String
  lastName        String
  avatarUrl       String?
  rating          Decimal          @default(0) @db.Decimal(3, 2)
  experienceYears Int              @default(0)

  applications JobApplication[]

  @@map("worker_profiles")
  @@schema("workers")
}

// ─── OUTBOX ───────────────────────────────────────────────────────────────────

model OutboxEvent {
  id          String   @id @default(uuid())
  topic       String
  payload     Json
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  error       String?

  @@map("outbox_events")
  @@schema("applications")
}
