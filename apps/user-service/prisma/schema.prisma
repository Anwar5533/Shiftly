// ─── Prisma Schema — SHIFTLY User Service ───────────────

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum AvailabilityType {
  FULL_TIME
  PART_TIME
  WEEKENDS
  FLEXIBLE
}

enum EmployeeCountRange {
  RANGE_1_10
  RANGE_11_50
  RANGE_51_200
  RANGE_201_500
  RANGE_501_1000
  RANGE_1000_PLUS
}

enum KycStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  RESIDENCE_PERMIT
  PROOF_OF_ADDRESS
  BUSINESS_REGISTRATION
  RESUME
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewTarget {
  WORKER
  EMPLOYER
}

// ─── WORKERS SCHEMA ───────────────────────────────────────────────────────────

model WorkerProfile {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  firstName       String
  lastName        String
  bio             String?
  avatarUrl       String?
  location        Json // JobLocation object
  experienceYears Int              @default(0)
  availability    AvailabilityType @default(FLEXIBLE)
  hourlyRate      Decimal?         @db.Decimal(10, 2)
  currency        String           @default("INR") @db.VarChar(3)
  rating          Decimal          @default(0) @db.Decimal(3, 2)
  totalReviews    Int              @default(0)
  totalJobsDone   Int              @default(0)
  responseRate    Decimal          @default(100) @db.Decimal(5, 2)
  isVerified      Boolean          @default(false)
  kycStatus       KycStatus        @default(NOT_STARTED)
  resumeUrl       String?
  portfolioUrl    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  skills         WorkerSkill[]
  certifications WorkerCertification[]

  @@map("worker_profiles")
}

model Skill {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  category  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  workers   WorkerSkill[]

  @@map("skills")
}

model WorkerSkill {
  workerId    String   @db.Uuid
  skillId     String   @db.Uuid
  yearsExp    Int      @default(0)
  proficiency String   @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | EXPERT
  addedAt     DateTime @default(now())

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill  Skill         @relation(fields: [skillId], references: [id])

  @@id([workerId, skillId])
  @@map("worker_skills")
}

model WorkerCertification {
  id          String    @id @default(uuid()) @db.Uuid
  workerId    String    @db.Uuid
  name        String
  issuer      String
  issueDate   DateTime
  expiryDate  DateTime?
  documentUrl String?
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_certifications")
}

// ─── EMPLOYERS SCHEMA ─────────────────────────────────────────────────────────

model EmployerProfile {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @unique @db.Uuid
  companyName   String
  industry      String
  logoUrl       String?
  website       String?
  description   String?
  location      Json // JobLocation object
  employeeCount EmployeeCountRange @default(RANGE_1_10)
  rating        Decimal            @default(0) @db.Decimal(3, 2)
  totalReviews  Int                @default(0)
  isVerified    Boolean            @default(false)
  kycStatus     KycStatus          @default(NOT_STARTED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  departments Department[]

  @@map("employer_profiles")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  employerId String   @db.Uuid
  name       String
  headCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@map("departments")
}

// ─── RECRUITERS SCHEMA ────────────────────────────────────────────────────────

model RecruiterProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  firstName       String
  lastName        String
  agencyName      String?
  bio             String?
  avatarUrl       String?
  specialisations String[]
  placements      Int       @default(0)
  successRate     Decimal   @default(0) @db.Decimal(5, 2)
  rating          Decimal   @default(0) @db.Decimal(3, 2)
  totalReviews    Int       @default(0)
  isVerified      Boolean   @default(false)
  kycStatus       KycStatus @default(NOT_STARTED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("recruiter_profiles")
}

// ─── REVIEWS SCHEMA ───────────────────────────────────────────────────────────

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  jobId      String       @db.Uuid
  reviewerId String       @db.Uuid
  targetId   String       @db.Uuid
  targetType ReviewTarget
  rating     Int // 1-5
  comment    String?
  isPublic   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([jobId, reviewerId, targetId])
  @@index([targetId])
  @@map("reviews")
}

// ─── KYC SCHEMA ──────────────────────────────────────────────────────────────

model KycRequest {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  status          KycStatus @default(PENDING)
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?   @db.Uuid
  rejectionReason String?
  notes           String?

  @@index([status])
  @@map("kyc_requests")
}

model KycDocument {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  type            DocumentType
  fileUrl         String
  fileName        String
  fileSize        Int
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime       @default(now())
  reviewedAt      DateTime?

  @@index([userId])
  @@map("kyc_documents")
}

// ─── OUTBOX ───────────────────────────────────────────────────────────────────

model OutboxEvent {
  id          String   @id @default(uuid())
  topic       String
  payload     Json
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  error       String?

  @@map("outbox_events")
}
