// ─── Prisma Schema — SHIFTLY Jobs Service ───────────────

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-jobs-service"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["jobs", "workers", "employers", "identity", "recruiters", "applications"]
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum JobType {
  SHIFT
  PERMANENT
  GIG
  @@schema("jobs")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  FILLED
  CANCELLED
  ARCHIVED
  EXPIRED
  @@schema("jobs")
}

enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
  FIXED
  @@schema("jobs")
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  @@schema("jobs")
}

// ─── JOBS SCHEMA ─────────────────────────────────────────────────────────────

model Job {
  id                     String       @id @default(uuid()) @db.Uuid
  employerId             String       @db.Uuid
  recruiterId            String?      @db.Uuid
  departmentId           String?      @db.Uuid
  title                  String
  description            String
  aiOptimisedDescription String?
  jobType                JobType
  status                 JobStatus    @default(DRAFT)
  location               Json // JobLocation object
  isRemote               Boolean      @default(false)
  salaryMin              Decimal      @db.Decimal(12, 2)
  salaryMax              Decimal      @db.Decimal(12, 2)
  salaryCurrency         String       @default("INR") @db.VarChar(3)
  salaryPeriod           SalaryPeriod @default(HOURLY)
  startDate              DateTime
  endDate                DateTime?
  shiftDurationHours     Decimal?     @db.Decimal(4, 2)
  positionsTotal         Int          @default(1)
  positionsFilled        Int          @default(0)
  applicationDeadline    DateTime?
  viewCount              Int          @default(0)
  applicationCount       Int          @default(0)
  publishedAt            DateTime?
  expiresAt              DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  shifts Shift[]

  @@index([employerId])
  @@index([employerId, status])
  @@index([employerId, createdAt(sort: Desc)])
  @@index([status])
  @@index([status, jobType])
  @@index([jobType])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("jobs")
  @@schema("jobs")
}

model Shift {
  id               String      @id @default(uuid()) @db.Uuid
  jobId            String      @db.Uuid
  applicationId    String      @unique @db.Uuid
  workerId         String      @db.Uuid
  status           ShiftStatus @default(SCHEDULED)
  scheduledStart   DateTime
  scheduledEnd     DateTime
  actualStart      DateTime?
  actualEnd        DateTime?
  clockInLocation  Json?
  clockOutLocation Json?
  hoursWorked      Decimal?    @db.Decimal(6, 2)
  overtimeHours    Decimal?    @db.Decimal(6, 2)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([workerId])
  @@index([status])
  @@index([scheduledStart, scheduledEnd])
  @@map("shifts")
  @@schema("jobs")
}

// ─── OUTBOX ───────────────────────────────────────────────────────────────────

model OutboxEvent {
  id          String   @id @default(uuid())
  topic       String
  payload     Json
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  error       String?

  @@map("outbox_events")
  @@schema("jobs")
}
